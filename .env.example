# ─────────────────────────────────────────────────────────────────
# .env.example  —  copy to .env and fill in your real values
# NEVER commit your actual .env file to version control
# ─────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
DEBUG=false

# ── Forager ──────────────────────────────────────────────────────
# Get these from your Forager dashboard → Settings → API
FORAGER_API_KEY=your_forager_api_key_here
FORAGER_ACCOUNT_ID=your_forager_account_id_here

# ── HubSpot ──────────────────────────────────────────────────────
# Create a Private App in HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read/write, crm.objects.companies.read/write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here
HUBSPOT_PORTAL_ID=your_hubspot_portal_id_here

# ── Contact-finding defaults ──────────────────────────────────────
# Comma-separated job titles to filter when discovering contacts
DEFAULT_JOB_TITLES=CTO,VP Engineering,VP of Engineering,Software Engineer,Product Manager

# Maximum contacts to discover per company
MAX_CONTACTS_PER_COMPANY=5

# ── Webhook security (optional but recommended) ───────────────────
# A shared secret to validate incoming API requests to /api/* routes
# Set to any random string; pass it as X-API-KEY header in requests
WEBHOOK_SECRET=your_optional_shared_secret_here
